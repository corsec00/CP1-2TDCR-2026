# 0 Variáveis
$MyACR = 'CloudsecFiaplss001'
$MyRG = 'RG-CloudSec-FIAP'
$My2ACR = 'acr561867'
$MyAKS = 'AKSFIAPCloudSec00x'



az role assignment create --assignee-object-id f99bbb0a-8c15-4da9-a249-f229dda3b99f --assignee-principal-type Group --role "User Access Administrator" --scope /subscriptions/e788df9b-c8c6-43e5-8a01-037e2c5bba4d/resourceGroups/RG-CloudSec-FIAP
az role assignment create --assignee-object-id f99bbb0a-8c15-4da9-a249-f229dda3b99f --assignee-principal-type Group --role "Contribuitor" --scope /subscriptions/e788df9b-c8c6-43e5-8a01-037e2c5bba4d/resourceGroups/RG-CloudSec-FIAP



# 1 Cria o ACR Principal
# az acr create --name $MyACR --resource-group $MyRG --sku Premium
az account set --subscription "VSEnt"
# 2 Cria o AKS Principal
az aks create --resource-group $MyRG --name $MyAKS --node-count 2 --node-vm-size Standard_D4s_v5 --enable-managed-identity --network-plugin azure

# 3 - Vincula o AKS ao Primeiro ACR
az aks update --resource-group $MyRG --name $MyAKS --attach-acr $MyACR

# 4 - Vincula outros ACRs (vc precisa de a - obter o ID dos outros ACRs e b- conceder permissão ao AKS)
az acr show --name $My2ACR --query id -o tsv
$ManIdent = (az aks show --resource-group $MyRG --name $MyAKS --query identity.principalId -o tsv)

 az role assignment create --assignee $ManIdent --role AcrPull --scope <ACR_ID>
## ou
az aks update --resource-group $MyRG --name $MyAKS --attach-acr $My2ACR
## Validar a permissão
az role assignment list --scope $(az acr show --name $My2ACR --query id -o tsv)

# 5 Criar Node Pools 
## de Sistema
#az aks nodepool add --resource-group $MyRG --cluster-name $MyAKS --name system --mode System --node-count 3
## Geral
az aks nodepool add --resource-group $MyRG --cluster-name $MyAKS --name apps --mode User --node-count 3 --node-vm-size Standard_D4s_v5
## de Alta memória
#az aks nodepool add --resource-group $MyRG --cluster-name $MyAKS --name memory --mode User --node-vm-size Standard_E8s_v5

# 6 Direcionar as aplicações para Pools específicos


# 7 Separar as aplicações por Namespace
az aks get-credentials --resource-group $MyRG --name $MyAKS
kubectl get nodes


kubectl create namespace app-a
kubectl create namespace app-b
kubectl create namespace app-c
(Ver arquivo Quotas.yaml)

# Verificar a existência do Link da ACR
$KubeletId = az aks show -g $MyRG -n $MyAKS --query identityProfile.kubeletidentity.objectId -o tsv
az role assignment list --assignee $KubeletId --all -o table

# Pegar o FQDN do ACR
az acr show --name $MyACR --query loginServer -o tsv
az acr show --name $My2ACR --query loginServer -o tsv

az acr repository list --name $MyACR -o table
az acr repository list --name $My2ACR -o table

# Verificando as Tags das imagens
az acr repository show-tags --name $MyACR --repository rabelindo-azure-vote -o table
az acr repository show-tags --name $My2ACR --repository rabelindo-azure-vote -o table
(ver arquivo .\deployment.yaml)

kubectl apply -f deployment.yaml
kubectl apply -f app-b.yaml

kubectl get pods -n app-561867 -o wide


az acr repository show-tags --name $MyACR --repository rabelindo-azure-vote -o table

az acr show --name $MyACR --query loginServer -o tsv
kubectl expose deployment app-a --port=80 --target-port=80 --type=LoadBalancer -n app-561867
